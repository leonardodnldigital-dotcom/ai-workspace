#!/bin/bash
# ══════════════════════════════════════════════════════════════
# ai-kill-all — Mata TODAS as sessões Herdr de projeto
# Preserva a sessão "main" criada no boot do container.
# ══════════════════════════════════════════════════════════════
set -euo pipefail

SESSIONS=$(herdr session list --json | jq -r '.sessions[] | select(.name != "main" and .name != "default") | [.name, .running] | @tsv')

if [ -z "$SESSIONS" ]; then
    echo "ℹ️  Nenhuma sessão de projeto pra matar."
    exit 0
fi

echo "Sessões a matar:"
echo "$SESSIONS" | cut -f1 | sed 's/^/  - /'
read -rp "Confirmar? [s/N]: " CONFIRM
case "$CONFIRM" in
    s|S|sim|y|Y|yes)
        echo "$SESSIONS" | while read -r s running; do
            if [ "$running" = true ]; then
                herdr session stop "$s" >/dev/null || exit 1
            fi
            herdr session delete "$s" >/dev/null || exit 1
            echo "  ✓ $s"
        done
        ;;
    *)
        echo "Cancelado."
        ;;
esac
