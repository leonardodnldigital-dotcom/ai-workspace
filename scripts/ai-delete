#!/bin/bash
# ══════════════════════════════════════════════════════════════
# ai-delete — Encerra sessão Herdr e apaga pasta do projeto
# Uso: ai-delete <nome-do-projeto>
# ══════════════════════════════════════════════════════════════

PROJECT="${1:?Uso: ai-delete <nome-do-projeto>}"
[[ "$PROJECT" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ && "$PROJECT" != main && "$PROJECT" != default ]] || { echo "Nome de projeto inválido: $PROJECT" >&2; exit 1; }
PROJECT_DIR="$HOME/projects/$PROJECT"

if [ ! -d "$PROJECT_DIR" ]; then
    echo "❌ Projeto '$PROJECT' não encontrado em $PROJECT_DIR"
    exit 1
fi

echo "⚠️  Isso vai APAGAR permanentemente:"
echo "   📁 $PROJECT_DIR"
SESSION_LIST=$(herdr session list --json) || exit 1
if jq -e --arg name "$PROJECT" '.sessions[] | select(.name == $name)' <<< "$SESSION_LIST" >/dev/null; then
    echo "   🖥️  Sessão Herdr '$PROJECT'"
fi
echo ""
read -p "Digite o nome do projeto ($PROJECT) para confirmar: " confirm
if [ "$confirm" != "$PROJECT" ]; then
    echo "❌ Nome não confere. Cancelado."
    exit 0
fi

# Mata sessão Herdr se existir
SESSION_LIST=$(herdr session list --json) || exit 1
RUNNING=$(jq -r --arg name "$PROJECT" '.sessions[] | select(.name == $name) | .running' <<< "$SESSION_LIST") || exit 1
if [ -n "$RUNNING" ]; then
    if [ "$RUNNING" = true ]; then
        herdr session stop "$PROJECT" >/dev/null || exit 1
    fi
    herdr session delete "$PROJECT" >/dev/null || exit 1
    echo "🗑️  Sessão '$PROJECT' encerrada."
fi

# Apaga pasta do projeto
rm -rf "$PROJECT_DIR" 2>/dev/null

if [ -d "$PROJECT_DIR" ]; then
    echo "⚠️  Alguns arquivos não puderam ser apagados (permissões root)."
    echo "   Rode no HOST: ai-fix-perms && ai-delete $PROJECT"
    echo "   Ou:           docker exec -u root <container> rm -rf $PROJECT_DIR"
    exit 1
fi
echo "🗑️  Projeto '$PROJECT' apagado de $PROJECT_DIR"
